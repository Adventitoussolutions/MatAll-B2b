    "ios": {
      "icon": "./assets/expo.icon",
      "config": {
        "googleMapsApiKey": "AIzaSyDmDT2lO73oKrO3gwJNvFgiJ55vCmrDaIU"
      }
    },
    "android": {
      "adaptiveIcon": {
