{
  "expo": {
    "name": "MatAll StudiOS",
    "slug": "MatAll-B2b",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "matallstudios",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "3",
      "icon": "./assets/images/logo.png",
      "bundleIdentifier": "com.adventitoussolutions.matallb2b",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6BBBAE",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.adventitoussolutions.matallb2b"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6BBBAE",
          "image": "./assets/images/logo.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyDmDT2lO73oKrO3gwJNvFgiJ55vCmrDaIU",
          "androidGoogleMapsApiKey": "AIzaSyDmDT2lO73oKrO3gwJNvFgiJ55vCmrDaIU"
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "f271edd2-098d-4d70-b28d-2d328ca0ede7"
      }
    }
  }
}
